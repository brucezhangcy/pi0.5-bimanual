 logger = logging.getLogger(__name__)
 
 
+def _reset_realsense_cameras(settle_s: float = 8.0) -> None:
+    """Hardware-reset all connected RealSense devices and wait for re-enumeration.
+
+    The kernel UVC driver does not immediately release USB iso-bandwidth reservations
+    when a stream ends, so a second run launched soon after a successful one tends
+    to starve one camera on the iso schedule and fail with `async_read` timeouts.
+    hardware_reset() forces each device to renegotiate bandwidth from scratch.
+    Adds ~8 s to startup; tradable for not having to manually reset between runs.
+    """
+    try:
+        import pyrealsense2 as rs
+        import time
+        ctx = rs.context()
+        devs = list(ctx.devices)
+        if not devs:
+            logger.warning("no RealSense devices found to reset")
+            return
+        logger.info(f"resetting {len(devs)} RealSense devices for a clean USB iso schedule...")
+        for d in devs:
+            try:
+                d.hardware_reset()
+            except Exception as e:
+                serial = d.get_info(rs.camera_info.serial_number) if hasattr(d, "get_info") else "?"
+                logger.warning(f"  reset failed for {serial}: {e}")
+        time.sleep(settle_s)
+        n_after = len(list(rs.context().devices))
+        logger.info(f"reset complete; {n_after} devices re-enumerated")
+    except Exception as e:
+        logger.warning(f"RealSense reset skipped (continuing anyway): {e}")
+
+# Hard joint limits for the WidowX AI (from URDF / stationary_ai.xml actuator ctrlrange).
+# Dataset action order: [L_j0..L_j5, L_grip, R_j0..R_j5, R_grip]. Arm joints are radians,
+# gripper is the carriage slide in meters [0, 0.044]. We clamp with a 1-2 mrad / 1 mm
+# margin inside the firmware's hard limits to defend against floating-point overshoot --
+# the firmware rejects ANY out-of-range command (even 0.044022 vs 0.044000) and idles
+# the motor, which then breaks the control loop and disconnect path. See dev_log v3 eval.
+_ARM_LO_HI = [
+    (-3.05433 + 1e-3, 3.05433 - 1e-3),  # j0
+    (0.0     + 1e-3, 3.14159 - 1e-3),  # j1
+    (0.0     + 1e-3, 2.35619 - 1e-3),  # j2
+    (-1.5708 + 1e-3, 1.5708  - 1e-3),  # j3
+    (-1.5708 + 1e-3, 1.5708  - 1e-3),  # j4
+    (-3.14159 + 1e-3, 3.14159 - 1e-3), # j5
+]
+_GRIP_LO_HI = (0.001, 0.043)  # 1 mm margin from both ends of [0, 0.044]
+ACTION_LO = np.array([lo for lo, _ in _ARM_LO_HI] + [_GRIP_LO_HI[0]] +
+                     [lo for lo, _ in _ARM_LO_HI] + [_GRIP_LO_HI[0]])
+ACTION_HI = np.array([hi for _, hi in _ARM_LO_HI] + [_GRIP_LO_HI[1]] +
+                     [hi for _, hi in _ARM_LO_HI] + [_GRIP_LO_HI[1]])
+
+
 class TrossenOpenPIBridge:
     """Bridge between a Trossen AI Stationary Kit and OpenPI policy server."""
 
