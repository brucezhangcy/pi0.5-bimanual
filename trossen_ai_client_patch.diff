-    bridge.autonomous_mode(task_prompt=args.task_prompt)
-
-    bridge.cleanup()
+    try:
+        bridge.autonomous_mode(task_prompt=args.task_prompt)
+    except KeyboardInterrupt:
+        logger.info("Ctrl+C: stopping policy loop, returning arms to rest pose...")
+    finally:
+        # cleanup() -> robot.disconnect() smoothly drives BOTH arms to the staged
+        # positions (2s) then the sleep/zero pose (2s), then releases. Running it in
+        # `finally` means Ctrl+C and crashes also return the arms to rest, not just a
+        # normal finish. NOTE: this rest move is itself motion -- for a real emergency
+        # (collision imminent) use the physical e-stop, not Ctrl+C.
+        bridge.cleanup()
