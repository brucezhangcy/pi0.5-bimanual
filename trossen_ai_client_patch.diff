@@ -100,6 +173,14 @@ class TrossenOpenPIBridge:
     def execute_action(self, action: np.ndarray):
         """Execute action on the arm."""
         full_action = action.copy()
+        # Defend against floating-point overshoot of hard joint limits (the firmware
+        # rejects any out-of-range command and idles the motor, breaking the control
+        # loop AND the disconnect path -- see dev_log v3 eval crash on grip=0.044022).
+        clamped = np.clip(full_action, ACTION_LO, ACTION_HI)
+        if not np.array_equal(clamped, full_action):
+            n = int(np.sum(clamped != full_action))
+            logger.warning(f"clamped {n}/14 action dims to safe joint range")
+        full_action = clamped
 
         if self.test_mode == "test":
             logger.info(f"TEST MODE: Would execute action: {full_action}")
@@ -259,6 +340,14 @@ if __name__ == "__main__":
         max_steps=args.max_steps,
     )
 
-    bridge.autonomous_mode(task_prompt=args.task_prompt)
-
-    bridge.cleanup()
+    try:
+        bridge.autonomous_mode(task_prompt=args.task_prompt)
+    except KeyboardInterrupt:
+        logger.info("Ctrl+C: stopping policy loop, returning arms to rest pose...")
+    finally:
+        # cleanup() -> robot.disconnect() smoothly drives BOTH arms to the staged
+        # positions (2s) then the sleep/zero pose (2s), then releases. Running it in
